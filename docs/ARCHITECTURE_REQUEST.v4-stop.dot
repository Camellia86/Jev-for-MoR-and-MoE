digraph Qwen {
  graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.5", splines=polyline, fontname="Noto Sans CJK SC", fontsize=20, labelloc=t, label="修订版：请求级两动作循环架构 + 第一级单向停止\n提示词末位决策一次 · 块边界只能从 r=2 降为 1 · 单尾 · 总轮数 r∈{1,2}"];
  node [shape=box, style="rounded", fontname="Noto Sans CJK SC", fontsize=13, margin="0.16,0.10", penwidth=1.3];
  edge [fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.75];

  input [label="消费已知输入\n首次：整段提示词；随后：新生成的 token\n位置 i 的输出预测 x_{i+1}"];
  s [label="S：第 0–31 层\n原权重冻结"];
  u [label="u：共享前缀出口", shape=ellipse];
  f1 [label="F¹：第 32–43 层，首轮\n启用生成 LoRA · 写入首轮 KV\n每个位置都执行，与动作无关"];
  h1 [label="h¹：首轮出口", shape=ellipse];
  kv1 [label="首轮 KV：逐层独立保存\n第 43 层提示词 KV 可供 Q 只读"];
  input -> s -> u -> f1 -> h1;
  f1 -> kv1 [style=dashed, label="建立 / 更新"];

  subgraph cluster_control {
    label="提示词末位决策：仅在提示词处理完毕时执行一次";
    fontname="Noto Sans CJK SC"; fontsize=15; style="rounded,dashed"; penwidth=1.2;
    h [label="H：MLP 2052→256→256→1\n读 h¹_P 与已知状态 z\n预测完整答案 NLL 差 Δℓ̂_H"];
    cost [label="公共成本模型：岭回归，只读 z\nΔĉ = α₀(P) + 条件矩 E[n|z]、E[1/n|z] 项\nĉ_Q = C_Q(P)·Ê[1/n|z]\n请求级控制器与门控共用"];
    gate [shape=diamond, label="门控：预测查询真实收益\nΔ̂^Q(λ) > λ·ĉ_Q ？\n（收益可为负）", fontsize=12];
    q [label="Q：两层只读查询控制器\n512 维查询；读取已有 KV\n不写生成缓存、不增加 token\n输出 Δℓ̂_Q = Δℓ̂_H + 残差"];
    choose [label="同一选择规则\n若 Δℓ̂ + λ·Δĉ < 0，启用第二轮 r=2\n否则 r=1 到回答结束"];
    h -> gate;
    cost -> gate [style=dashed];
    gate -> choose [label="否：使用 H"];
    gate -> q [label="是：支付 Q 费用"];
    q -> choose [label="使用 Q"];
    cost -> choose [style=dashed];
  }
  h1 -> h [style=dashed, label="仅提示词末位 + 已知状态"];
  h1 -> gate [style=dashed];
  kv1 -> q [style=dashed, label="仅提示词 KV；只读"];

  route [shape=diamond, label="当前轮数 r？", fontsize=12];
  h1 -> route;
  choose -> route [style=dashed, label="设定初始 r"];

  subgraph cluster_stop {
    label="块边界停止：仅在第二轮运行中、到达块边界 b_c（c≥2）时执行";
    fontname="Noto Sans CJK SC"; fontsize=15; style="rounded,dashed"; penwidth=1.2;
    bnd [shape=diamond, label="位置是块边界 b_c？\n（上一块末 token 刚输入）", fontsize=12];
    hstop [label="H_stop：MLP 2054→256→256→1\n读 h¹_{b_c} 与边界状态 z_{d,c}\n预测 ŷ：现在停止使 NLL 增加多少"];
    costb [label="块成本回归\n预测本块第二轮成本 Û/n\n（E[n_c/n]、E[n_c²/n] 两个条件矩）"];
    stopdec [shape=diamond, label="一步前瞻：ŷ < λ·Û/n ？\n与提示词末位共用价格 λ", fontsize=12];
    bnd -> hstop [label="是"];
    hstop -> stopdec;
    costb -> stopdec [style=dashed];
  }
  route -> bnd [label="r=2"];
  h1 -> hstop [style=dashed, label="h¹_{b_c}"];

  mix [label="追加轮输入\nv² = u + tanh(g) ⊙ (h¹−u)"];
  f2 [label="F²：再次执行第 32–43 层\n与 F¹ 共用权重及 LoRA\n独立第二轮 KV，覆盖到最后一个 r=2 位置"];
  h2 [label="h²：第二轮出口", shape=ellipse];
  tail [label="唯一生成尾 T：第 44–47 层 + LoRA\n提示词按所选出口完整预填充\n逐位置读取实际出口，尾缓存保存 h¹/h² 混合历史"];
  head [label="原最终归一化 + 词表头\n生成下一个 token"];
  eos [shape=diamond, label="EOS / 长度上限？", fontsize=12];
  end [label="结束", shape=ellipse];

  route -> tail [label="r=1：使用 h¹"];
  bnd -> mix [label="否：继续 r=2"];
  stopdec -> mix [label="否：本块继续 r=2"];
  stopdec -> tail [label="是：停止第二轮\n此后 r=1，使用 h¹"];
  u -> mix [style=dashed, label="保留当前输入 u"];
  mix -> f2 -> h2 -> tail -> head -> eos;
  eos -> end [label="是"];
  eos -> input [label="否：自回归继续；r 只能在块边界由 2 降为 1", constraint=false];

  controls [shape=note, label="对照控制器（只用于评价，不进入部署路径）\nZ：与 H 同结构、只读 z 的 MLP（P1 中与随机分配 U-mix 比较，P2 中作 H 的对照）\nN：H 的首轮表示换成噪声（阴性对照）；R：z 上的线性岭回归（描述）\n停止侧：Z_stop、N_stop、R_stop 与之一一对应\n每个策略族另含强制全程 r=1 与强制全程 r=2 两个端点，端点上不运行控制器", fontsize=11];
  note [shape=note, label="执行不变量\n1. 启用第二轮时，第二轮在提示词上也完整预填充，费用单列。\n2. F¹/F² 共享权重与 LoRA，不共享 KV；只有一个生成尾。\n3. 轮数只能在块边界从 2 降为 1，降为 1 后不再变回；\n   部署无历史补写、无尾追赶，F² 覆盖到最后一个 r=2 位置。\n4. H、Q、门控与停止控制器只读生成表示；固定动作时，执行控制器不得改变生成分布。\n5. 本图以 ARCHITECTURE_REQUEST.v4.dot 为底图，改动其不变量 3（单向停止），并把不变量 4 扩展到门控与停止控制器。", fontsize=12];
  schedule [shape=note, label="训练日程（不属于执行不变量）\nG_two：全程 r=1、全程 r=2、停止、开启 = 1/3、1/3、1/6、1/6\n开启类按精确补写（B0）训练，部署只用停止", fontsize=11];
  end -> controls [style=invis];
  controls -> note [style=invis];
  controls -> schedule [style=invis];
}
